DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Required only when the seed creates the first administrator. Supply real values
# through a secure local or deployment environment; never commit them. The password
# must be at least 15 characters. The 4-digit PIN is optional. Remove these values
# from the runtime environment after the administrator has been created.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PIN=

# Explicit credentials for local smoke/credential verification scripts only.
# Keep real values out of source control and CI configuration.
SMOKE_ADMIN_USERNAME=
SMOKE_ADMIN_PASSWORD=
SMOKE_ADMIN_PIN=
